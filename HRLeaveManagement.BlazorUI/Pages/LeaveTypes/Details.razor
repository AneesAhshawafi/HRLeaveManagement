@page "/leaveTypes/details/{id:int}"
@using HRLeaveManagement.BlazorUI.Components.LeaveTypes

<PageTitle>Leave Type Details</PageTitle>

<h3>Leave Type Details</h3>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-danger" role="alert" aria-live="polite">
        <p class="mb-0">@Message</p>
    </div>
}

@if (LeaveType is null)
{
    @if (string.IsNullOrEmpty(Message))
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <a href="/leave-types/" class="btn btn-outline-secondary">Back to List</a>
    }
}
else
{
    <FormComponent LeaveType="LeaveType" Disabled="true" />
    <div class="mt-2">
        <a href="/leaveTypes/edit/@id" class="btn btn-warning">Edit</a>
    </div>
}
